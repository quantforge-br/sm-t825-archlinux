# Device dumps, private firmware and build output: never commit
/artifacts/
/backup/
/firmware/
/out/
/dl/
/y/
/.firecrawl/
pwhash
*.ext4
*.ext2
# Release binaries are uploaded as release assets; only the checksums are tracked
/release/*
!/release/SHA256SUMS
# Local agent state, session logs and Python caches
/.pi/
/codex-session-*.md
__pycache__/
