@@ -44,6 +239,26 @@ build() {
 	unset LDFLAGS
 	make ARCH="$_carch" LLVM=1 \
 		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
+
+	# Early warning for the reference layout: 50 MiB boot memory, 22222608-byte
+	# initramfs, 2 MiB tags and zero text_offset. The installer is the real
+	# size guarantee: it computes the budget from the actual initramfs/header.
+	# pmbootstrap may not forward LK2ND_MAX_KERNEL_SIZE into the build chroot.
+	# lk2nd extlinux.c:578-595 compares decompressed bytes, not image_size.
+	local image_size max_size=${LK2ND_MAX_KERNEL_SIZE:-28106752}
+	case "$max_size" in
+		''|*[!0-9]*) error "Invalid LK2ND_MAX_KERNEL_SIZE: $max_size"; return 1 ;;
+	esac
+	if ! [ "$max_size" -gt 0 ] || ! [ "$max_size" -le 4294967295 ]; then
+		error "LK2ND_MAX_KERNEL_SIZE must be between 1 and 4294967295"
+		return 1
+	fi
+	image_size=$(wc -c < "arch/$_carch/boot/Image")
+	if [ "$image_size" -gt "$max_size" ]; then
+		error "Kernel too big for lk2nd extlinux: $image_size bytes > $max_size"
+		return 1
+	fi
+	echo "lk2nd size check: $image_size bytes <= $max_size"
 }
 
