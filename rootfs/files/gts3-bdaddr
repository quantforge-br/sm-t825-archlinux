#!/bin/sh
# Give the QCA6174 Bluetooth controller its per-device address.
# The NVM file only carries a placeholder (00:00:00:00:5a:ad), so hci_qca
# leaves hci0 unconfigured until a public address is set. Samsung keeps the
# real one in bluetooth/bt_addr on the efs partition; mount it read-only
# (noload: never replay the journal) just long enough to read it.
#
# Setting the address makes hci_qca run its setup again. At boot this races
# with bluetoothd and the HCI reset can time out (-110), leaving no usable
# controller. If the controller does not show up as configured, rebind the
# serdev driver once and set the address again.
set -eu
dev=/dev/disk/by-partlabel/efs
mnt=$(mktemp -d)
mount -o ro,noload "$dev" "$mnt"
addr=$(tr -d '\r\n ' < "$mnt/bluetooth/bt_addr")
umount "$mnt"
rmdir "$mnt"
case "$addr" in
??:??:??:??:??:??) ;;
*) echo "gts3-bdaddr: unexpected bt_addr format" >&2; exit 1 ;;
esac

set_addr() {
	i=0
	until btmgmt --index 0 public-addr "$addr" >/dev/null 2>&1; do
		i=$((i + 1))
		[ "$i" -lt 30 ] || { echo "gts3-bdaddr: controller not ready" >&2; return 1; }
		sleep 1
	done
}

configured() {
	i=0
	while [ "$i" -lt 15 ]; do
		btmgmt info 2>/dev/null | grep -q "^hci0:" && return 0
		i=$((i + 1))
		sleep 1
	done
	return 1
}

set_addr
configured && exit 0

echo "gts3-bdaddr: hci0 did not come up after setting the address, rebinding the driver" >&2
serdev=$(readlink -f /sys/class/bluetooth/hci0/device)
driver=$(readlink -f "$serdev/driver")
name=$(basename "$serdev")
echo "$name" > "$driver/unbind"
sleep 2
echo "$name" > "$driver/bind"
i=0
until [ -e /sys/class/bluetooth/hci0 ]; do
	i=$((i + 1))
	[ "$i" -lt 30 ] || { echo "gts3-bdaddr: hci0 did not reappear" >&2; exit 1; }
	sleep 1
done
set_addr
configured || { echo "gts3-bdaddr: hci0 still not configured" >&2; exit 1; }
